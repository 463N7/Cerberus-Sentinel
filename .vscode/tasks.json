{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sentinel: All host checks and screen previews",
      "type": "process",
      "command": "python",
      "args": ["tools/test_sentinel.py"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Sentinel: Build and package development candidate",
      "type": "process",
      "command": "python",
      "args": ["tools/build_sentinel.py", "--target", "all", "--package"],
      "problemMatcher": ["$gcc"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Sentinel: Build matched S3 + C5 + bridge",
      "type": "process",
      "command": "python",
      "args": ["tools/build_sentinel.py", "--target", "all"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Sentinel: Build touchscreen (S3)",
      "type": "process",
      "command": "python",
      "args": ["tools/build_sentinel.py", "--target", "s3"],
      "problemMatcher": ["$gcc"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Sentinel: Build onboard radio (C5)",
      "type": "process",
      "command": "python",
      "args": ["tools/build_sentinel.py", "--target", "c5"],
      "problemMatcher": ["$gcc"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Sentinel: Package verified build",
      "type": "process",
      "command": "python",
      "args": ["tools/package_sentinel.py"],
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Sentinel: Protocol checks",
      "type": "process",
      "command": "python",
      "args": ["tools/test_protocol.py"],
      "group": "test",
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    }
  ]
}
