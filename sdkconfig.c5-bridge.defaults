# Use USB-OTG CDC for the temporary C5 bridge. Unlike the S3 native
# USB-Serial/JTAG endpoint, CDC control-line changes cannot reset the S3 while
# C5 esptool traffic is in flight.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Cerberus C5 Flash Bridge"
CONFIG_TINYUSB_DESC_CDC_STRING="Cerberus C5 Bridge"
